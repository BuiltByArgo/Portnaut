+/* Preserve the previous Wine OpenGL feature-level selection for Rockstar's
+ * launcher UI only. Do not advertise polygon-offset-clamp support itself. */
+BOOL wined3d_rockstar_legacy_feature_levels(void)
+{
+    WCHAR path[MAX_PATH], enabled[2], *base;
+    if (GetEnvironmentVariableW(L"GTM_ROCKSTAR_SWIFTSHADER", enabled, 2) != 1 || enabled[0] != L'1')
+        return FALSE;
+    if (!GetModuleFileNameW(NULL, path, ARRAY_SIZE(path))) return FALSE;
+    base = wcsrchr(path, L'\\');
+    base = base ? base + 1 : path;
+    return !wcsicmp(base, L"Launcher.exe") || !wcsicmp(base, L"LauncherPatcher.exe")
+            || !wcsicmp(base, L"SocialClubHelper.exe");
+}
