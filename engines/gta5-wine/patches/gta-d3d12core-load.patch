+/* D3DMetal 3 exposes D3D12 directly. GTA also checks that its core module
+ * is loaded after device creation. Keep that module resident for this profile
+ * only, matching the newer renderer's module-loading behavior. */
+static void gta_load_d3d12core( const WCHAR *name, DWORD flags )
+{
+    WCHAR exe[MAX_PATH], enabled[2];
+    const WCHAR *base;
+
+    if (flags & (LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_DATAFILE_EXCLUSIVE |
+                 LOAD_LIBRARY_AS_IMAGE_RESOURCE | DONT_RESOLVE_DLL_REFERENCES)) return;
+    base = wcsrchr( name, '\\' );
+    base = base ? base + 1 : name;
+    if (wcsicmp( base, L"d3d12.dll" )) return;
+    if (GetEnvironmentVariableW( L"GTM_ROCKSTAR_SWIFTSHADER", enabled, 2 ) != 1 || enabled[0] != '1') return;
+    if (!GetModuleFileNameW( NULL, exe, MAX_PATH )) return;
+    base = wcsrchr( exe, '\\' );
+    if (wcsicmp( base ? base + 1 : exe, L"GTA5_Enhanced.exe" )) return;
+    if (!GetModuleHandleW( L"d3d12core.dll" ))
+        LoadLibraryExW( L"d3d12core.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32 );
+}
+
